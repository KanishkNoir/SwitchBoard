{
  "mcpServers": {
    "switchboard": {
      "command": "uv",
      "args": [
        "run",
        "--project",
        ".",
        "python",
        "-m",
        "switchboard.mcp_server"
      ],
      "env": {
        "SWITCHBOARD_AGENT_KEY_FILE": ".tmp/agent-keys/claude-code.key",
        "SWITCHBOARD_DB": "switchboard.db",
        "SWITCHBOARD_REMOTE_URL": "https://cogni-noir--switchboard-web.us-east.modal.run"
      }
    }
  }
}
