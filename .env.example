# Copy to .env and fill in. Never commit real keys.
BASETEN_API_KEY=
BASETEN_MODEL_ID=meta-models/muse-spark-open-1026
BASETEN_BASE_URL=https://inference.baseten.co/v1
# Modal: proxy token pair for deployed endpoints (Bearer <id>.<secret>), or adapter URLs
MODAL_PROXY_TOKEN_ID=
MODAL_PROXY_TOKEN_SECRET=
MODAL_ROUTING_AFFINITY_KEY=
MODAL_CHAT_URL=
MODAL_CHAT_MODEL=meta-models/Muse-Spark-Open-816B-A42B
SWITCHBOARD_REASONING_PROVIDER=modal
# Meta Model API (OpenAI-compatible). Provider order falls back modal -> baseten -> meta (or your pick first).
META_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
META_MODEL=muse-spark-1.3
META_IMAGE_MODEL=muse-image-1.0
META_SEGMENTATION_MODEL=sam-3.1
MODAL_SEGMENTATION_URL=
MODAL_IMAGE_URL=
MODAL_T2_URL=
# Switchboard local settings
SWITCHBOARD_DB=switchboard.db
SWITCHBOARD_ENABLE_T3=false
SWITCHBOARD_ENABLE_SEGMENTATION=false
SWITCHBOARD_ENABLE_IMAGE=false
